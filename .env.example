# T3N Nebius Edition
# Copy to .env locally if your runtime loads env files, or export variables in your shell.
# Never commit real credentials.

# Required only for live Nebius Token Factory inference.
NEBIUS_API_KEY=

# Optional overrides. Defaults are safe for the hackathon build.
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Keep disabled for zero-cost mocked demo/tests.
RUN_NEBIUS_MODEL=0

# Existing T3N approval gateway settings.
APPROVAL_SECRET=change-me-locally
APPROVAL_TTL_SECONDS=300
PORT=3000
